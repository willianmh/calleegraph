# Copy to .env and fill in for local development.

# --- GitHub ---
# Bootstrap PAT (optional). If set and the DB has no PAT yet, it seeds the
# settings row on startup. Can also be set later via PUT /api/settings.
GITHUB_PAT=
GITHUB_API_VERSION=2022-11-28
GITHUB_API_BASE=https://api.github.com

# --- Required ---
# Fernet key encrypting the PAT at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
DATABASE_URL=postgresql+asyncpg://calleegraph:calleegraph@localhost:5432/calleegraph
REDIS_URL=redis://localhost:6379/0

# --- Optional (defaults shown) ---
GRAPH_CACHE_TTL_SECONDS=300
FETCH_CONCURRENCY=3
CORS_ORIGINS=http://localhost:5173
