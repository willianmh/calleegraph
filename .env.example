# Calleegraph — single source of configuration (orchestrator prompt §6).
# Copy to `.env` and fill in, then `docker compose up --build`.

# --- GitHub (backend) ---
# Optional bootstrap PAT: if set and the DB has none, it seeds the settings row
# on startup. It can also be set in-app via Settings. Needs `repo` /
# `contents:read` scope to read private repos; public repos work without a PAT
# but at much lower rate limits.
GITHUB_PAT=
GITHUB_API_VERSION=2022-11-28
# Override for GitHub Enterprise, e.g. https://github.example.com/api/v3
GITHUB_API_BASE=https://api.github.com

# --- Backend runtime ---
# Required. Fernet key encrypting the PAT at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
DATABASE_URL=postgresql+asyncpg://calleegraph:calleegraph@postgres:5432/calleegraph
REDIS_URL=redis://redis:6379/0
# Safety-net expiry for the assembled-graph cache; the primary invalidation
# path is explicit, on any repository state change.
GRAPH_CACHE_TTL_SECONDS=300
# Max repos fetched/parsed in parallel.
FETCH_CONCURRENCY=3
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Frontend ---
# nginx proxies this prefix to the backend service.
API_BASE=/api
